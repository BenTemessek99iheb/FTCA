# Copier ce fichier en .env (même dossier, racine du repo — pas ftca-fifak/)
# et renseigner les vraies valeurs. .env est ignoré par git (voir .gitignore
# racine) — ne jamais committer de vrais identifiants.
#
# Utilisé par ftca-fifak/scripts/upload-to-cloudinary.js (npm run
# upload-assets) et ftca-fifak/scripts/verify-cloudinary-assets.js (npm run
# verify-cloudinary), lancés depuis ftca-fifak/ — voir ASSETS.md §"Comment
# une image est servie" pour le pourquoi (assetUrl() sert les images depuis
# Cloudinary, pas depuis dist/.../assets/ local ; rien ne pousse les
# nouvelles images vers Cloudinary automatiquement, ce fichier + ces deux
# scripts sont l'étape manuelle qui le fait).

# Cloudinary → Settings → API Keys (compte du projet, cloud name "ykjb5rh5"
# au moment de la rédaction de ce fichier).
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret
