# FTCA / FIFAK — Apache config pour SPA Angular sur cPanel (Apache 2.4)
# Ce fichier est copié automatiquement dans dist/ftca-fifak/browser/ au build
# (voir angular.json > architect.build.options.assets) et doit donc être
# déployé tel quel à la racine du dossier web (public_html/ ou équivalent).

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) www -> non-www (canonique : https://ftca-fifak.tn)
  RewriteCond %{HTTP_HOST} ^www\.ftca-fifak\.tn$ [NC]
  RewriteRule ^(.*)$ https://ftca-fifak.tn/$1 [L,R=301]

  # 2) Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://ftca-fifak.tn/%{REQUEST_URI} [L,R=301]

  # 3) /assets/ sert toujours des fichiers réels (images, fonts, icônes) :
  #    court-circuite explicitement le fallback SPA ci-dessous pour ce
  #    préfixe. Redondant avec les conditions !-f/!-d de la règle 4 (un
  #    fichier /assets/ existant ne serait de toute façon jamais réécrit),
  #    mais rend l'intention explicite et évite d'évaluer inutilement ces
  #    conditions sur ce préfixe à fort trafic.
  RewriteRule ^assets/ - [L]

  # 4) Routage Angular (SPA) : toute requête qui ne correspond pas à un
  #    fichier ou dossier réel est renvoyée vers index.html, pour laisser
  #    le Router Angular gérer la route (ex: /fifak-2026, /fifak-2026#programme)
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# --- Compression Gzip ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE application/font-woff application/font-woff2 font/woff font/woff2
</IfModule>

# --- Cache navigateur ---
# Les bundles JS/CSS Angular sont hashés (outputHashing: all) : ils peuvent
# être mis en cache très longtemps sans risque, un nouveau build produit
# de nouveaux noms de fichiers. index.html ne doit jamais être mis en cache
# (sinon les visiteurs restent bloqués sur une ancienne version de l'app).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2?|ttf|eot|svg|png|jpe?g|gif|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  # Désactive le sniffing MIME (protection basique, sans impact sur le SPA)
  Header set X-Content-Type-Options "nosniff"
</IfModule>

# --- Page d'erreur 404 : renvoie vers l'app (cohérent avec le fallback SPA ci-dessus) ---
ErrorDocument 404 /index.html
