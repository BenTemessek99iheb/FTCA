# Copier ce fichier en .env et renseigner les vraies valeurs.
# .env est ignoré par git (voir .gitignore) — ne jamais committer de vrais identifiants.
# Utilisé uniquement par deploy-manual.sh pour un déploiement FTP manuel en local.
# (Le workflow GitHub Actions n'utilise PAS ce fichier : il lit les GitHub Secrets
#  du même nom, configurés séparément dans Settings > Secrets and variables > Actions
#  — voir DEPLOYMENT.md § "Configurer les secrets GitHub")

# Hôte FTP fourni par l'hébergeur cPanel (cPanel > FTP Accounts).
# Peut être un nom d'hôte (ftp.ftca-fifak.tn) ou une IP selon l'hébergeur.
FTP_SERVER=ftp.ftca-fifak.tn

# Identifiant du compte FTP cPanel (créer un compte FTP dédié au déploiement
# plutôt que d'utiliser le compte cPanel principal est recommandé).
FTP_USERNAME=votre_identifiant_ftp_cpanel

# Mot de passe du compte FTP cPanel correspondant à FTP_USERNAME.
FTP_PASSWORD=votre_mot_de_passe_ftp_cpanel

# Dossier distant où déployer le site. /public_html/ si ftca-fifak.tn est le
# domaine principal du compte cPanel ; /public_html/ftca-fifak.tn/ (ou
# équivalent) si c'est un addon domain — vérifier dans cPanel > Domains.
FTP_SERVER_DIR=/public_html/
